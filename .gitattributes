# Normaliza finais de linha no repositório (LF), independente do SO.
* text=auto eol=lf

# Scripts do Windows precisam de CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
